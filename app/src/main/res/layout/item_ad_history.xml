<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="5dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/txtHistoryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="06 Jan 2026, 06:20 PM"
            android:textSize="12sp"
            android:textColor="#6A7AA8"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHistoryHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Headline goes here"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0B1B3A"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/txtHistorySnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Short preview..."
            android:textColor="#3B4A6B"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnHistoryCopy"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Copy"
                android:textStyle="bold"
                android:backgroundTint="#0B1B3A"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnHistoryDelete"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Delete"
                android:textStyle="bold"
                android:backgroundTint="#E53935"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
