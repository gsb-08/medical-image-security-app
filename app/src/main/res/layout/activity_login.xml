<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background_color"
    tools:context=".LoginActivity">

    <LinearLayout
        android:id="@+id/signup_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="32dp">

        <TextView
            android:id="@+id/text2_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans"
            android:text="Don't have an account?   "
            android:textColor="@color/app_secondary_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/SignUp_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_bold"
            android:text="Sign up"
            android:textColor="@color/app_accent_green"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/img_illustration"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:contentDescription="Medicine Reminder"
        app:srcCompat="@drawable/ic_camera_blue"
        app:tint="@color/app_accent_green" />

    <TextView
        android:id="@+id/textView"
        style="@style/TextAppearance.AppCompat.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/img_illustration"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="@font/dm_sans_bold"
        android:text="Welcome Back"
        android:textAlignment="center"
        android:textColor="@color/app_primary_text"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textView"
        android:layout_alignStart="@id/textView"
        android:layout_alignEnd="@id/textView"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/dm_sans"
        android:text="Sign in to your account"
        android:textAlignment="center"
        android:textColor="@color/app_secondary_text"
        android:textSize="16sp" />


    <androidx.cardview.widget.CardView
        android:id="@+id/login_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textView2"
        android:layout_alignStart="@id/textView"
        android:layout_alignEnd="@id/textView"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/card_background_color"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <EditText
                android:id="@+id/email_box"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/premium_edittext_bg"
                android:ems="10"
                android:fontFamily="@font/dm_sans"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColorHint="@color/app_hint_text" />

            <EditText
                android:id="@+id/pass_box"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/premium_edittext_bg"
                android:drawableEnd="@drawable/visibility_off"
                android:drawableTint="@color/app_accent_green"
                android:ems="10"
                android:fontFamily="@font/dm_sans"
                android:hint="Password"
                android:inputType="textPassword"
                android:longClickable="false"
                android:paddingStart="20dp"
                android:paddingEnd="10dp"
                android:textColorHint="@color/app_hint_text" />

            <TextView
                android:id="@+id/forgotpass_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/dm_sans_bold"
                android:text="Forgot password"
                android:textColor="@color/app_accent_green"
                android:textStyle="bold" />

            <include
                android:id="@+id/login_button"
                layout="@layout/progress_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <View
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <View
        android:id="@+id/guideline3"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <View
        android:id="@+id/guideline_left"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <View
        android:id="@+id/guideline_right"
        android:layout_width="0dp"
        android:layout_height="0dp" />

</RelativeLayout>